{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*", "validate/**/*"],
  "exclude": ["node_modules", "dist", "src/index.ts"]
}
