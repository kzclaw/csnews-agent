#!/bin/sh
# ============================================================
# csnews commit-msg hook · 沈继元 advisory (派活 41 v0.37.23)
#
# 功能:
#   检查 commit message 跟 git diff --cached --stat 的文件列表
#   是否一致 (msg 必须 提及 每个 changed file)
#   避免 "msg 写 1 file 实际 2 files" 这类 沈继元 flag 的 同款错误
#   (派活 33 / 0ae0e1a / 0a4df9b 三次出现, 戴舒柯 CSNEWS 文化 commit hygiene 严)
#
# 关键设计 (戴舒柯 CSNEWS 文化):
#   - msg hygiene 是 5 重安全网 第 5 重 (commit msg privacy grep) 的 延伸
#   - 沈继元 verifier 拍板 'commit msg 跟 --stat 一致' 是 工程纪律
#   - local hook 不入仓 (跟 pre-commit + post-commit 同样 pattern, .gitignore line 73)
# ============================================================

set -e

COMMIT_MSG_FILE="$1"
if [ -z "$COMMIT_MSG_FILE" ] || [ ! -f "$COMMIT_MSG_FILE" ]; then
  exit 0  # no msg file (e.g. merge commit), skip check
fi

MSG=$(cat "$COMMIT_MSG_FILE")

# Skip merge commits / revert commits (msg 格式特殊)
case "$MSG" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*)
    exit 0
    ;;
esac

# Get staged files (--cached) — this 是 commit 时 实际 staged 的 files
STAGED_FILES=$(git diff --cached --name-only 2>/dev/null || true)

# 检查: 每个 staged file 必须 在 msg 中提及
MISSING=""
for f in $STAGED_FILES; do
  if ! echo "$MSG" | grep -qF "$f"; then
    MISSING="$MISSING $f"
  fi
done

if [ -n "$MISSING" ]; then
  echo "[commit-msg] FAIL: msg 缺失以下 file 提及 (跟 --stat 不一致):"
  for f in $MISSING; do
    echo "  - $f"
  done
  echo ""
  echo "[commit-msg] git diff --cached --stat:"
  git diff --cached --stat
  echo ""
  echo "[commit-msg] commit msg 全文:"
  cat "$COMMIT_MSG_FILE"
  echo ""
  echo "[commit-msg] 沈继元 advisory 闭环: msg 必须 跟 --stat 一致 (派活 33 / 0ae0e1a / 0a4df9b 三次出现)"
  exit 1
fi

echo "[commit-msg] OK · commit msg 跟 staged files ($STAGED_FILES) 一致"
exit 0
