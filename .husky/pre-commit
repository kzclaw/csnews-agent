#!/usr/bin/env bash
# Pre-commit hook · delegates to csnews-agent/scripts/check-privacy.sh
# Auto-configured by package.json "prepare" script (husky 9 installs core.hooksPath)
# 23:27 privacy tooling gitignored (local, optional for new contributors)

set -e
GIT_ROOT=$(git rev-parse --show-toplevel)
SCRIPT_PATH="$GIT_ROOT/csnews-agent/scripts/check-privacy.sh"

if [ ! -f "$SCRIPT_PATH" ]; then
  echo "⚠️ check-privacy.sh not found (gitignored, optional)"
  echo "   Privacy check skipped. Restore from git history to enable:"
  echo "     git checkout HEAD~1 -- csnews-agent/scripts/check-privacy.sh"
  exit 0
fi

bash "$SCRIPT_PATH"