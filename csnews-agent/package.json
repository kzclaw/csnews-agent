{
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260609.1",
    "@mozilla/readability": "^0.6.0",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.8",
    "husky": "^9.1.7",
    "linkedom": "^0.18.12",
    "prettier": "^3.5.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"validate/**/*.ts\"",
    "lint": "prettier --check \"src/**/*.ts\" \"validate/**/*.ts\"",
    "validate": "vitest run",
    "validate:watch": "vitest",
    "validate:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  }
}
