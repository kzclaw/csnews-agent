{
  // CSNEWS Agent · TS 配置（v0.33+sweep·FT-KR0 · Phase0 · 支撑 typecheck + vitest）
  // 兼容 Cloudflare Workers（wrangler 用 esbuild bundler）+ vitest（import 解析）
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "types": ["@cloudflare/workers-types"],

    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    // Worker runtime 全局类型（fetch / Request / Response / URLSearchParams 等）
    "isolatedModules": true
  },
  "include": ["src/**/*", "validate/**/*", "vitest.config.ts"]
}